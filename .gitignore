# dependencies
node_modules/

# build output
dist/
.astro/

# env / secrets
.env
.env.*
!.env.example
.secrets/

# editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# raw asset drop zone (not source of truth; use src/assets/ for committed assets)
assets-inbox/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# build-time caches (rewritten every run; not source of truth for local dev,
# but we DO commit .songlink-cache.json so prod builds don't lose
# platform-link data when Odesli's public API is unavailable (deprecated
# 2026-08). Same for .itunes-cache.json (Apple Music fallback) and
# .releases-cache.json (last-known-good release manifest).
# Uncomment to hide again if we ever move to a fully-live API path.
#.itunes-cache.json
#.releases-cache.json
#.songlink-cache.json

